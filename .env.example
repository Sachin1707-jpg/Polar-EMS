# POLAR-EMS Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=POLAR-EMS
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Configuration
DATABASE_URL=sqlite:///./polar_ems.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/polar_ems

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Weather Service Integration (Optional)
WEATHER_API_KEY=your-weather-api-key
WEATHER_UPDATE_INTERVAL=300

# AI/ML Configuration
AI_MODEL_UPDATE_INTERVAL=3600
FORECAST_HORIZON_HOURS=48
OPTIMIZATION_INTERVAL=900

# Alert Configuration
ALERT_EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
ALERT_RECIPIENTS=["admin@polarstation.org"]

# Data Simulation
SIMULATION_MODE=true
SIMULATION_SPEED=1.0
SIMULATION_START_DATE=2026-01-01

# Redis (for production caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/polar_ems.log
